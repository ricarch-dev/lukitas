generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum TransactionKind {
  OPENING
  INCOME
  EXPENSE
}

enum FxSource {
  MARKET
  MANUAL
}

enum RecurrenceCadence {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  passwordHash    String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  preferences     UserPreferences?
  accounts        Account[]
  bankGroups      BankGroup[]
  transactions    Transaction[]
  transfers       Transfer[]
  sessions        RefreshSession[]
  resetTokens     PasswordResetToken[]
  auditEvents     AuditEvent[]
  idempotencyKeys IdempotencyKey[]
  categories      Category[]
  budgets         Budget[]
  recurringRules  RecurringRule[]
}

model UserPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  baseCurrency       String
  timezone           String
  onboardingComplete Boolean  @default(false)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency           Currency @relation(fields: [baseCurrency], references: [code])
}

model Currency {
  code         String            @id
  precision    Int
  active       Boolean           @default(true)
  preferences  UserPreferences[]
  accounts     Account[]
  transactions Transaction[]
  ratesAsBase  FxRate[]          @relation("FxBase")
  ratesAsQuote FxRate[]          @relation("FxQuote")
  budgets      Budget[]
}

model Account {
  id                   String          @id @default(uuid())
  userId               String
  name                 String
  bankGroupId          String?
  currencyCode         String
  openingBalance       String
  archivedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankGroup            BankGroup?      @relation(fields: [bankGroupId, userId], references: [id, userId])
  currency             Currency        @relation(fields: [currencyCode], references: [code])
  transactions         Transaction[]
  entries              LedgerEntry[]
  sourceTransfers      Transfer[]      @relation("TransferSource")
  destinationTransfers Transfer[]      @relation("TransferDestination")
  recurringRules       RecurringRule[]

  @@index([userId, archivedAt])
}

model BankGroup {
  id             String    @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts       Account[]

  @@unique([userId, normalizedName])
  @@unique([id, userId])
}

model Transaction {
  id           String                 @id @default(uuid())
  userId       String
  accountId    String
  kind         TransactionKind
  amount       String
  currencyCode String
  occurredAt   DateTime
  note         String?
  voidedAt     DateTime?
  voidReason   String?
  transferId   String?
  categoryId   String?
  createdAt    DateTime               @default(now())
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currency     Currency               @relation(fields: [currencyCode], references: [code])
  transfer     Transfer?              @relation(fields: [transferId], references: [id], onDelete: SetNull)
  entries      LedgerEntry[]
  category     Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fxSnapshot   TransactionFxSnapshot?
  recurrence   RecurringOccurrence?

  @@index([userId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([userId, categoryId, occurredAt])
}

model Category {
  id             String          @id @default(uuid())
  userId         String
  name           String
  normalizedName String
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@unique([userId, normalizedName])
  @@index([userId, archivedAt])
}

model Budget {
  id           String   @id @default(uuid())
  userId       String
  categoryId   String
  monthKey     String
  timezone     String
  currencyCode String
  limit        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currency     Currency @relation(fields: [currencyCode], references: [code])

  @@unique([userId, categoryId, monthKey])
  @@index([userId, monthKey])
}

model RecurringRule {
  id             String                @id @default(uuid())
  userId         String
  accountId      String
  categoryId     String?
  kind           TransactionKind
  amount         String
  currencyCode   String
  note           String?
  cadence        RecurrenceCadence
  timezone       String
  startAt        DateTime
  endAt          DateTime?
  nextOccurrence DateTime
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category       Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences    RecurringOccurrence[]

  @@index([userId, active, nextOccurrence])
}

model RecurringOccurrence {
  id            String        @id @default(uuid())
  ruleId        String
  occurrenceAt  DateTime
  transactionId String        @unique
  createdAt     DateTime      @default(now())
  rule          RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([ruleId, occurrenceAt])
  @@index([ruleId, occurrenceAt])
}

model TransactionFxSnapshot {
  id             String      @id @default(uuid())
  transactionId  String      @unique
  sourceCurrency String
  baseCurrency   String
  sourceAmount   String
  baseAmount     String
  rate           String
  effectiveAt    DateTime
  source         FxSource
  createdAt      DateTime    @default(now())
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([baseCurrency, effectiveAt])
}

model LedgerEntry {
  id            String      @id @default(uuid())
  transactionId String
  accountId     String
  signedAmount  String
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model Transfer {
  id                   String        @id @default(uuid())
  userId               String
  sourceAccountId      String
  destinationAccountId String
  sourceAmount         String
  destinationAmount    String
  sourceCurrency       String
  destinationCurrency  String
  feeAmount            String?
  occurredAt           DateTime
  createdAt            DateTime      @default(now())
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount        Account       @relation("TransferSource", fields: [sourceAccountId], references: [id])
  destinationAccount   Account       @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  transactions         Transaction[]
  snapshot             FxSnapshot?

  @@index([userId, occurredAt])
}

model FxRate {
  id          String   @id @default(uuid())
  baseCode    String
  quoteCode   String
  rate        String
  effectiveAt DateTime
  source      FxSource
  createdAt   DateTime @default(now())
  base        Currency @relation("FxBase", fields: [baseCode], references: [code])
  quote       Currency @relation("FxQuote", fields: [quoteCode], references: [code])

  @@unique([baseCode, quoteCode, effectiveAt])
}

model FxSnapshot {
  id          String           @id @default(uuid())
  transferId  String           @unique
  effectiveAt DateTime
  source      FxSource
  createdAt   DateTime         @default(now())
  transfer    Transfer         @relation(fields: [transferId], references: [id], onDelete: Cascade)
  rates       FxSnapshotRate[]
}

model FxSnapshotRate {
  id         String     @id @default(uuid())
  snapshotId String
  baseCode   String
  quoteCode  String
  rate       String
  snapshot   FxSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, baseCode, quoteCode])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String
  action    String
  targetId  String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  userId      String
  key         String
  fingerprint String
  response    Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
