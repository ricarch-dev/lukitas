{
  "name": "@lukitas/api",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy && pnpm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/apps/api/src/main.js",
    "smoke": "node test/smoke.mjs",
    "test": "node --test --experimental-strip-types test/*.spec.*",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@lukitas/contracts": "workspace:*",
    "@lukitas/domain": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@node-rs/argon2": "1.7.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "jose": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "prisma": "7.10.0",
    "tsx": "4.23.12"
  }
}
